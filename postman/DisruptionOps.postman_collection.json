{
 "info": {
  "name": "DisruptionOps \u00b7 PayPal agentic commerce API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Multi-agent (LangGraph) buyer-side agent team with a PayPal sandbox money layer and seven Buyer Shield guards. Run '1 \u00b7 Auth / login' first; the token is stored automatically."
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{token}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "base",
   "value": "https://agentic-logistic-orchestration-system.onrender.com"
  },
  {
   "key": "token",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1 \u00b7 Auth",
   "item": [
    {
     "name": "GET /api/health",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base}}/api/health",
       "host": [
        "{{base}}"
       ],
       "path": [
        "api",
        "health"
       ],
       "variable": []
      },
      "description": "Health"
     }
    },
    {
     "name": "POST /api/auth/login",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base}}/api/auth/login",
       "host": [
        "{{base}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ],
       "variable": []
      },
      "description": "Auth Login",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"demo@disruptionops.io\",\n  \"password\": \"DemoPass123!\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json();",
         "pm.collectionVariables.set('token', j.token || j.access_token);"
        ]
       }
      }
     ]
    }
   ]
  },
